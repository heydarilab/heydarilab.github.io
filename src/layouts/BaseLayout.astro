---
/**
 * BaseLayout — every page wraps in this.
 * Handles <head>, fonts, OG/SEO tags, the global header + footer,
 * and the tiny IntersectionObserver that powers scroll reveals.
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  /** Page title shown in the browser tab and OG metadata. */
  title: string;
  /** Short meta description for search engines and social cards. */
  description?: string;
  /** Path to an OG image relative to the site root. */
  ogImage?: string;
  /** Optional page-specific class on <main>. */
  mainClass?: string;
}

const {
  title,
  description = "MAGICS Lab — design and governance of intelligent complex systems. Multi-agent, networked, sociotechnical research at Northeastern University.",
  ogImage = "/og-image.png",
  mainClass = "",
} = Astro.props;

const siteName = "MAGICS Lab";
const fullTitle =
  title === siteName ? title : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Fonts: Fraunces (display serif) + Inter (sans). Preconnected
         for a tiny perf win on first paint. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
    />

    <!-- Theme color matches the cream page background -->
    <meta name="theme-color" content="#1B2A3A" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-cream-card focus:text-ink focus:px-3 focus:py-2 focus:rounded focus:shadow-card"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class={`flex-1 ${mainClass}`}>
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Lightweight scroll-reveal: when an element with [data-reveal]
      // intersects the viewport, add `.is-visible`. CSS handles the rest.
      // Respects prefers-reduced-motion (the CSS short-circuits there).
      (() => {
        const prefersReduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const els = document.querySelectorAll("[data-reveal]");
        if (prefersReduced || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
