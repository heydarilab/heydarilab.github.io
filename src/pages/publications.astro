// Group by year, newest first.
const byYear = entries.reduce<Record<number, Entry[]>>((acc, e) => {
  (acc[e.year] ||= []).push(e);
  return acc;
}, {});
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Publications"
  description="Selected publications by members of the MAGICS Lab, 2021–present. Full list on Google Scholar."
>
  <section class="max-w-page mx-auto px-5 sm:px-8 pt-16 sm:pt-24">
    <p class="eyebrow mb-3">Publications</p>
    <h1 class="h-display text-4xl sm:text-6xl leading-[1.05] max-w-3xl">
      Selected work.
    </h1>
    <p class="mt-6 text-ink-soft text-lg max-w-prose leading-relaxed">
      Lab publications from 2021 to today, grouped by year, newest first.
    </p>

    {/* Google Scholar callout */}
    <div
      class="mt-7 rounded-xl bg-cream-card ring-1 ring-rule/80 px-5 sm:px-6 py-4 sm:py-5 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5"
    >
      <p class="text-sm text-ink-soft leading-relaxed flex-1">
        For the complete and continuously-updated list, see Prof. Heydari's
        <span class="text-ink">Google Scholar</span> profile.
      </p>
      <a
        href={SCHOLAR_URL}
        class="inline-flex items-center gap-2 self-start sm:self-auto bg-ink text-cream px-4 py-2 rounded-full text-sm font-medium hover:bg-ember-dark transition-colors"
      >
        Google Scholar
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="max-w-page mx-auto px-5 sm:px-8 mt-16 sm:mt-20 pb-8">
    {
      years.map((y) => (
        <div class="mb-12">
          <SectionHeader eyebrow="Year" title={String(y)} />
          <ol class="divide-y hairline">
            {byYear[y].map((e) => (
              <li class="py-5 sm:py-6 flex flex-col sm:flex-row sm:gap-8">
                <span class="eyebrow shrink-0 sm:w-28 sm:pt-1">
                  {e.venue.split(",")[0].split("(")[0].trim()}
                </span>
                <div class="flex-1">
                  <p class="h-display text-lg sm:text-xl leading-snug mb-1">
                    {e.title}
                  </p>
                  <p class="text-sm text-ink-muted mb-1">{e.authors}</p>
                  <p class="text-sm text-ink-soft mb-2 italic">{e.venue}.</p>
                  {e.links && e.links.length > 0 && (
                    <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                      {e.links.map((l) => (
                        <a
                          href={l.href}
                          class="text-ember-dark underline decoration-ember/40 underline-offset-2 hover:decoration-ember"
                        >
                          {l.label}
                        </a>
                      ))}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>
</BaseLayout>
