---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

// ---------------------------------------------------------------
// Roster
//
// To add a member:
//   1. Append an entry to the `members` array below.
//   2. (Optional) drop a portrait into `public/team/<slug>.{jpg|png|webp}`
//      using the `slug` you set on the entry. If a matching file exists
//      it's used automatically; otherwise the initials placeholder shows.
//
// `kind`: "director" | "phd" | "postdoc" | "msc" | "alumni" | "visiting"
//   - "director" appears in the Director section.
//   - "phd" / "postdoc" / "msc" appear under Current members.
//   - "alumni" / "visiting" appear under Past graduate students & postdocs.
// ---------------------------------------------------------------
type Kind =
  | "director"
  | "phd"
  | "postdoc"
  | "msc"
  | "alumni"
  | "visiting";

type Member = {
  slug: string;
  name: string;
  role: string;
  kind: Kind;
  bio?: string;
  link?: string;
  /** Optional extra affiliation lines (e.g. department, institute). */
  affiliations?: string[];
};

const members: Member[] = [
  // ---- Current ----
  {
    slug: "babak-heydari",
    name: "Babak Heydari",
    role: "Director · Professor",
    kind: "director",
    affiliations: [
      "College of Engineering (MIE Department), Northeastern University",
      "Core faculty, Network Science Institute",
    ],
    bio: "Works on the design and governance of complex sociotechnical systems — from networked organizations to multi-agent AI — at the intersection of engineering, behavioral science, and policy.",
    link: "https://coe.northeastern.edu/people/heydari-babak/",
  },
  {
    slug: "negin-maddah",
    name: "Negin Maddah",
    role: "PhD Student",
    kind: "phd",
    bio: "Complex networks, computational social science, intelligent sociotechnical systems, and process mining.",
    link: "https://www.linkedin.com/in/neginmaddah/",
  },
  {
    slug: "sepehr-ilami",
    name: "Sepehr Ilami",
    role: "PhD Student",
    kind: "phd",
    bio: "Computational social science, collective behavior, and multi-agent decision-making — how humans and AI agents coordinate and influence each other in networked environments.",
    link: "https://sepehrilami.com/",
  },
  {
    slug: "nunzio-lore",
    name: "Nunzio Lorè",
    role: "PhD Student",
    kind: "phd",
    bio: "Network science, game theory, agent-based modeling, fairness in AI platforms — and the strategic behavior of large language models.",
    link: "https://netsi.khoury.northeastern.edu/people/nunzio-lore/",
  },
  {
    slug: "hongan-zhu",
    name: "Hongan Zhu",
    role: "PhD Student",
    kind: "phd",
    bio: "Multi-agent systems, AI governance, behavioral dynamics, network science, and public health.",
    link: "https://www.linkedin.com/in/hongan-zhu/",
  },

  // ---- Past graduate students & postdocs ----
  {
    slug: "qingtao-cao",
    name: "Qingtao Cao",
    role: "PhD",
    kind: "alumni",
    bio: "Network science, multi-agent systems, the sharing economy, computational methods for policy and regulation, spatiotemporal data analysis.",
  },
  {
    slug: "soumyakant-padhee",
    name: "Soumyakant Padhee",
    role: "PhD",
    kind: "alumni",
    bio: "Innovation in engineering design teams, causal identification in sociotechnical systems, experimental methods.",
  },
  {
    slug: "qiliang-chen",
    name: "Qiliang Chen",
    role: "PhD",
    kind: "alumni",
    bio: "Artificial intelligence, meta reinforcement learning, modularity, multi-agent systems, interpretable AI.",
  },
  {
    slug: "gabriele-ansaldo",
    name: "Gabriele Ansaldo",
    role: "MSc",
    kind: "alumni",
    bio: "Human–robot teaming, multi-agent systems, trustworthy AI.",
  },
  {
    slug: "mohsen-mosleh",
    name: "Mohsen Mosleh",
    role: "PhD",
    kind: "alumni",
  },
  {
    slug: "david-gianetto",
    name: "David Gianetto",
    role: "PhD",
    kind: "alumni",
  },
  {
    slug: "kia-dalili",
    name: "Kia Dalili",
    role: "Postdoctoral fellow",
    kind: "alumni",
  },
  {
    slug: "abhilash-janardhanan",
    name: "Abhilash Janardhanan",
    role: "MSc",
    kind: "alumni",
  },
  {
    slug: "liang-ke",
    name: "Liang Ke",
    role: "Graduate researcher",
    kind: "alumni",
  },
  {
    slug: "amar-chheda",
    name: "Amar Chheda",
    role: "Graduate researcher",
    kind: "alumni",
  },
  {
    slug: "peter-ludlow",
    name: "Peter Ludlow",
    role: "Graduate researcher",
    kind: "alumni",
  },
  {
    slug: "abbas-ehsanfar",
    name: "Abbas Ehsanfar",
    role: "Graduate researcher",
    kind: "alumni",
  },
  {
    slug: "yakov-bart",
    name: "Yakov Bart",
    role: "Visiting faculty",
    kind: "visiting",
  },
];

// ---- Photo lookup ----
// If a file matching the member's slug exists under public/team/, use it.
// Lets you drop a photo in later without editing this file again.
const TEAM_DIR = path.resolve("./public/team");
const photoExts = [".jpg", ".jpeg", ".png", ".webp"];
function photoFor(slug: string): string | undefined {
  for (const ext of photoExts) {
    const filename = `${slug}${ext}`;
    if (fs.existsSync(path.join(TEAM_DIR, filename))) {
      return `/team/${filename}`;
    }
  }
  return undefined;
}

const director = members.find((m) => m.kind === "director");
const currentStudents = members.filter((m) =>
  ["phd", "postdoc", "msc"].includes(m.kind),
);
const pastMembers = members.filter((m) =>
  ["alumni", "visiting"].includes(m.kind),
);

const initials = (name: string): string =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<BaseLayout
  title="Team"
  description="The people of the MAGICS Lab — director, current students, and past graduate students, postdocs, and visiting faculty."
>
  <section class="max-w-page mx-auto px-5 sm:px-8 pt-16 sm:pt-24">
    <p class="eyebrow mb-3">Team</p>
    <h1 class="h-display text-4xl sm:text-6xl leading-[1.05] max-w-3xl">
      The people behind the lab.
    </h1>
    <p class="mt-6 text-ink-soft text-lg max-w-prose leading-relaxed">
      A small group of researchers working across multi-agent systems,
      network science, and the governance of complex sociotechnical
      settings.
    </p>
  </section>

  {/* ============================ Banner ============================ */}
  <section
    class="max-w-page mx-auto px-5 sm:px-8 mt-10 sm:mt-12"
    data-reveal
  >
    <figure class="rounded-2xl overflow-hidden ring-1 ring-rule/80 bg-cream-card">
      <img
        src="/lab/banner.jpg"
        alt="MAGICS Lab moments — group photos in front of Northeastern University, in the lab, at conferences, and at graduation."
        width="1800"
        height="600"
        class="w-full h-auto"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

  {/* ============================ Director ============================ */}
  {
    director && (
      <section class="max-w-page mx-auto px-5 sm:px-8 mt-16 sm:mt-20">
        <SectionHeader eyebrow="Director" title={director.name} />
        <div
          class="grid sm:grid-cols-12 gap-6 sm:gap-10 items-start"
          data-reveal
        >
          <div class="sm:col-span-3">
            {photoFor(director.slug) ? (
              <img
                src={photoFor(director.slug)}
                alt={director.name}
                class="w-40 sm:w-full max-w-[180px] aspect-[4/5] object-cover rounded-xl ring-1 ring-rule"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="w-40 sm:w-full max-w-[180px] aspect-[4/5] rounded-xl bg-gradient-to-br from-ember/15 via-gold/15 to-teal/15 ring-1 ring-rule flex items-center justify-center font-display text-4xl text-ink/40">
                {initials(director.name)}
              </div>
            )}
          </div>
          <div class="sm:col-span-9">
            <p class="font-display text-2xl text-ink mb-1">{director.role}</p>
            {director.affiliations && director.affiliations.length > 0 && (
              <ul class="text-ink-soft text-sm leading-relaxed mb-3 space-y-0.5">
                {director.affiliations.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            )}
            {director.bio && (
              <p class="text-ink-soft leading-relaxed mb-4">{director.bio}</p>
            )}
            {director.link && (
              <a
                class="inline-flex items-center gap-2 text-sm font-medium text-ember-dark hover:text-ember"
                href={director.link}
              >
                Faculty page <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* ======================== Current students ======================== */}
  {
    currentStudents.length > 0 && (
      <section class="max-w-page mx-auto px-5 sm:px-8 mt-24">
        <SectionHeader eyebrow="Lab members" title="Current students." />
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {currentStudents.map((m, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${i * 80}ms`}
              class="p-5 sm:p-6 rounded-xl bg-cream-card ring-1 ring-rule/80 flex flex-col"
            >
              <div class="flex gap-4 items-start">
                <div class="shrink-0">
                  {photoFor(m.slug) ? (
                    <img
                      src={photoFor(m.slug)}
                      alt={m.name}
                      class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover ring-1 ring-rule"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-gradient-to-br from-ember/20 via-gold/20 to-teal/20 ring-1 ring-rule flex items-center justify-center font-display text-2xl text-ink/50">
                      {initials(m.name)}
                    </div>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="font-display text-lg leading-tight">{m.name}</p>
                  <p class="text-xs text-ink-muted mt-0.5 mb-2">{m.role}</p>
                  {m.link && (
                    <a
                      href={m.link}
                      class="inline-flex items-center gap-1 text-xs font-medium text-ember-dark hover:text-ember"
                    >
                      Website <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
              {m.bio && (
                <p class="mt-4 text-sm text-ink-soft leading-relaxed">
                  {m.bio}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ============================ Lab space ============================ */}
  <section class="max-w-page mx-auto px-5 sm:px-8 mt-24" data-reveal>
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <figure class="lg:col-span-7 rounded-2xl overflow-hidden ring-1 ring-rule/80 bg-cream-card">
        <img
          src="/lab/lab-space.jpg"
          alt="The MAGICS Lab space at Northeastern — open workstations along a window-lined corridor, a soft lounge area with armchairs and plants, and private offices behind glass walls."
          width="1600"
          height="1200"
          class="w-full h-auto"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="lg:col-span-5">
        <p class="eyebrow mb-3">Where we work</p>
        <h2 class="h-display text-3xl sm:text-4xl leading-tight mb-4">
          Our home at <span class="text-ember">Northeastern</span>.
        </h2>
        <p class="text-ink-soft leading-relaxed">
          The lab sits in Northeastern's Mechanical &amp; Industrial
          Engineering department, with open workstations, breakout
          spaces, and easy proximity to the Network Science Institute —
          the kind of room that nudges the work toward conversation
          across disciplines.
        </p>
      </div>
    </div>
  </section>

  {/* ================== Past graduate students & postdocs ================== */}
  {
    pastMembers.length > 0 && (
      <section class="max-w-page mx-auto px-5 sm:px-8 mt-24 mb-8">
        <SectionHeader
          eyebrow="Lab alumni"
          title="Past graduate students & postdocs."
          kicker="Members who have moved on to faculty positions, industry, and other research labs."
        />
        <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
          {pastMembers.map((m, i) => (
            <li
              data-reveal
              style={`--reveal-delay:${i * 40}ms`}
              class="p-4 sm:p-5 rounded-xl bg-cream-card/60 ring-1 ring-rule/60 flex gap-4 items-start"
            >
              <div class="shrink-0">
                {photoFor(m.slug) ? (
                  <img
                    src={photoFor(m.slug)}
                    alt={m.name}
                    class="w-14 h-14 rounded-full object-cover ring-1 ring-rule"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="w-14 h-14 rounded-full bg-gradient-to-br from-ember/10 via-gold/10 to-teal/10 ring-1 ring-rule flex items-center justify-center font-display text-base text-ink/45">
                    {initials(m.name)}
                  </div>
                )}
              </div>
              <div class="min-w-0">
                <p class="font-display text-base leading-tight">{m.name}</p>
                <p class="text-xs text-ink-muted mt-0.5">{m.role}</p>
                {m.bio && (
                  <p class="mt-2 text-xs text-ink-soft leading-relaxed">
                    {m.bio}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
