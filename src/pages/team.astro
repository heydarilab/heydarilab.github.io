---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";

// ---------------------------------------------------------------
// TODO — replace placeholder members with real entries.
// Add a member by appending an object to `members` below.
// `kind`: "director" | "phd" | "postdoc" | "alumni" | "collaborator"
// `photo`: optional path under /public/team/, e.g. "/team/jane.jpg"
// ---------------------------------------------------------------
type Member = {
  name: string;
  role: string;
  kind: "director" | "phd" | "postdoc" | "alumni" | "collaborator";
  bio?: string;
  link?: string;
  photo?: string;
};

const members: Member[] = [
  {
    name: "Babak Heydari",
    role: "Director · Professor, Northeastern University",
    kind: "director",
    bio: "Works on the design and governance of complex sociotechnical systems — from networked organizations to multi-agent AI.",
    link: "https://coe.northeastern.edu/people/heydari-babak/",
  },
  {
    name: "Lab Member — TODO",
    role: "PhD student",
    kind: "phd",
    bio: "Replace this placeholder with a real member. Edit src/pages/team.astro and append an entry to the members array.",
  },
  {
    name: "Lab Member — TODO",
    role: "Postdoctoral researcher",
    kind: "postdoc",
    bio: "Replace this placeholder. Photos go in public/team/.",
  },
];

const director = members.find((m) => m.kind === "director");
const others = members.filter((m) => m.kind !== "director");

const groupLabel: Record<Member["kind"], string> = {
  director: "Director",
  phd: "PhD students",
  postdoc: "Postdocs",
  alumni: "Alumni",
  collaborator: "Collaborators",
};

const byKind = (["phd", "postdoc", "alumni", "collaborator"] as const).map(
  (k) => ({
    key: k,
    label: groupLabel[k],
    items: others.filter((m) => m.kind === k),
  }),
);
---

<BaseLayout
  title="Team"
  description="The people of the MAGICS Lab — director, students, postdocs, and collaborators."
>
  <section class="max-w-page mx-auto px-5 sm:px-8 pt-16 sm:pt-24">
    <p class="eyebrow mb-3">Team</p>
    <h1 class="h-display text-4xl sm:text-6xl leading-[1.05] max-w-3xl">
      The people behind the lab.
    </h1>
    <p class="mt-6 text-ink-soft text-lg max-w-prose leading-relaxed">
      A small group of researchers working across multi-agent systems,
      network science, and the governance of complex sociotechnical settings.
    </p>
  </section>

  {
    director && (
      <section class="max-w-page mx-auto px-5 sm:px-8 mt-16 sm:mt-20">
        <SectionHeader eyebrow="Director" title={director.name} />
        <div
          class="grid sm:grid-cols-12 gap-6 sm:gap-10 items-start"
          data-reveal
        >
          <div class="sm:col-span-4">
            {director.photo ? (
              <img
                src={director.photo}
                alt={director.name}
                class="w-full rounded-xl ring-1 ring-rule"
              />
            ) : (
              <div class="aspect-[4/5] rounded-xl bg-gradient-to-br from-ember/15 via-gold/15 to-teal/15 ring-1 ring-rule flex items-center justify-center font-display text-5xl text-ink/40">
                {director.name
                  .split(" ")
                  .map((p) => p[0])
                  .join("")}
              </div>
            )}
          </div>
          <div class="sm:col-span-8">
            <p class="font-display text-2xl text-ink mb-1">{director.role}</p>
            {director.bio && (
              <p class="text-ink-soft leading-relaxed mb-4">{director.bio}</p>
            )}
            {director.link && (
              <a
                class="inline-flex items-center gap-2 text-sm font-medium text-ember-dark hover:text-ember"
                href={director.link}
              >
                Faculty page <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    byKind.map((group) =>
      group.items.length === 0 ? null : (
        <section class="max-w-page mx-auto px-5 sm:px-8 mt-20">
          <SectionHeader eyebrow="Lab members" title={group.label} />
          <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {group.items.map((m, i) => (
              <li
                data-reveal
                style={`--reveal-delay:${i * 60}ms`}
                class="p-5 sm:p-6 rounded-xl bg-cream-card ring-1 ring-rule/80 flex gap-4 items-start"
              >
                <div class="shrink-0">
                  {m.photo ? (
                    <img
                      src={m.photo}
                      alt={m.name}
                      class="w-16 h-16 rounded-full object-cover ring-1 ring-rule"
                    />
                  ) : (
                    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-ember/20 via-gold/20 to-teal/20 ring-1 ring-rule flex items-center justify-center font-display text-xl text-ink/50">
                      {m.name
                        .split(" ")
                        .map((p) => p[0])
                        .slice(0, 2)
                        .join("")}
                    </div>
                  )}
                </div>
                <div>
                  <p class="font-display text-lg leading-tight">{m.name}</p>
                  <p class="text-xs text-ink-muted mb-2">{m.role}</p>
                  {m.bio && (
                    <p class="text-sm text-ink-soft leading-relaxed">
                      {m.bio}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ),
    )
  }

  <section class="max-w-page mx-auto px-5 sm:px-8 mt-24 mb-8">
    <div
      class="rounded-xl bg-cream-card ring-1 ring-rule/80 p-6 sm:p-8 text-sm text-ink-muted"
    >
      <p>
        <strong class="text-ink">TODO:</strong> Replace placeholders above with the
        current team. The list lives in <code>src/pages/team.astro</code>; see the
        README for a template entry.
      </p>
    </div>
  </section>
</BaseLayout>
