---
/**
 * OverviewFigure — clean SVG recreation of the lab's overview figure.
 *
 * Visually mirrors the uploaded PNG: title bar, three numbered research
 * area cards arranged around a central MAGICS Lab node, and the
 * UNDERSTAND → MODEL → DESIGN → GOVERN strip across the bottom.
 *
 * Authored as inline SVG (rather than embedded raster) so it stays crisp
 * at any size and theme tweaks happen in one place. If you'd rather drop
 * in the raster PNG of the original figure, place it at
 *   public/figures/overview/magics-overview.png
 * and use that instead.
 */
interface Props {
  /** Optional extra classes on the wrapping figure element. */
  class?: string;
  /** When true, drops the four-stage strip at the bottom. */
  compact?: boolean;
}
const { class: klass = "", compact = false } = Astro.props;
---

<figure class={`relative ${klass}`}>
  <svg
    viewBox="0 0 1280 780"
    role="img"
    aria-labelledby="overview-title overview-desc"
    class="w-full h-auto"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="overview-title">
      MAGICS Lab overview: three research areas around a central
      multi-agent network motif, with a four-stage approach strip
      (Understand, Model, Design, Govern).
    </title>
    <desc id="overview-desc">
      Schematic of the MAGICS Lab. The top labels the lab's full name and
      mission. Three rounded panels describe research area 1 (Human and AI
      Agents), 2 (Network and Interaction Architecture), and 3 (System
      Behavior and Dynamics), arranged around a central circle containing
      a small network diagram. Below, an arrow strip moves from
      Understand to Model to Design to Govern.
    </desc>

    <defs>
      <!-- Color tokens, matched to tailwind.config.mjs -->
      <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#FFFBF1" />
        <stop offset="100%" stop-color="#FBF6EB" />
      </linearGradient>
      <radialGradient id="centerHalo" cx="50%" cy="50%" r="55%">
        <stop offset="0%" stop-color="#FFFBF1" stop-opacity="1" />
        <stop offset="100%" stop-color="#FFFBF1" stop-opacity="0" />
      </radialGradient>

      <marker
        id="arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M0,0 L10,5 L0,10 z" fill="#5B6C7E" />
      </marker>
    </defs>

    <rect width="1280" height="780" fill="url(#bg)" />

    <!-- Title bar -->
    <g font-family="Fraunces, Georgia, serif" font-weight="500">
      <text
        x="640"
        y="60"
        text-anchor="middle"
        font-size="38"
        fill="#1B2A3A"
      >
        <tspan fill="#E07B3F">Multi-Agent</tspan>
        <tspan> </tspan>
        <tspan fill="#D4A02A">Intelligent</tspan>
        <tspan> </tspan>
        <tspan fill="#3A8C8C">Complex Systems</tspan>
        <tspan> </tspan>
        <tspan fill="#1B2A3A">(MAGICS) Lab</tspan>
      </text>
    </g>
    <g font-family="Inter, sans-serif">
      <text
        x="640"
        y="92"
        text-anchor="middle"
        font-size="14"
        letter-spacing="3.5"
        fill="#34465A"
        font-weight="500"
      >
        DESIGN &amp; GOVERNANCE OF INTELLIGENT COMPLEX SYSTEMS
      </text>
      <line
        x1="170"
        y1="106"
        x2="1110"
        y2="106"
        stroke="#1B2A3A"
        stroke-width="1"
        stroke-opacity="0.4"
      />
      <circle cx="170" cy="106" r="3" fill="#1B2A3A" />
      <circle cx="1110" cy="106" r="3" fill="#1B2A3A" />
    </g>

    <!-- Top card: Human & AI Agents -->
    <g>
      <rect
        x="420"
        y="138"
        width="440"
        height="155"
        rx="14"
        fill="#F1E2B5"
        fill-opacity="0.55"
        stroke="#D4A02A"
        stroke-opacity="0.35"
      />
      <!-- numbered circle -->
      <circle cx="460" cy="172" r="14" fill="#D4A02A" />
      <text
        x="460"
        y="178"
        text-anchor="middle"
        font-family="Inter, sans-serif"
        font-size="16"
        font-weight="700"
        fill="#FFFBF1">1</text
      >
      <text
        x="486"
        y="178"
        font-family="Fraunces, Georgia, serif"
        font-size="22"
        font-weight="500"
        fill="#1B2A3A">Human &amp; AI Agents</text
      >
      <text
        x="486"
        y="210"
        font-family="Inter, sans-serif"
        font-size="14"
        fill="#34465A"
      >
        <tspan x="486" dy="0">Modeling, learning, and decision-making</tspan>
        <tspan x="486" dy="20">of social and AI agents.</tspan>
      </text>
      <!-- tiny human + bot motif -->
      <g transform="translate(444,238)" stroke="#1B2A3A" stroke-width="1.5" fill="none">
        <circle cx="0" cy="0" r="6" />
        <path d="M-7 16 q7 -10 14 0" />
        <line x1="0" y1="6" x2="0" y2="16" />
        <rect x="20" y="-6" width="14" height="18" rx="3" />
        <circle cx="24" cy="-2" r="1.5" fill="#1B2A3A" />
        <circle cx="30" cy="-2" r="1.5" fill="#1B2A3A" />
        <line x1="20" y1="-12" x2="34" y2="-12" />
        <line x1="27" y1="-12" x2="27" y2="-15" />
      </g>
    </g>

    <!-- Left card: Network & Interaction Architecture -->
    <g>
      <rect
        x="80"
        y="320"
        width="380"
        height="245"
        rx="14"
        fill="#F6DDC8"
        fill-opacity="0.55"
        stroke="#E07B3F"
        stroke-opacity="0.35"
      />
      <circle cx="118" cy="354" r="14" fill="#E07B3F" />
      <text
        x="118"
        y="360"
        text-anchor="middle"
        font-family="Inter, sans-serif"
        font-size="16"
        font-weight="700"
        fill="#FFFBF1">2</text
      >
      <text
        x="144"
        y="354"
        font-family="Fraunces, Georgia, serif"
        font-size="20"
        font-weight="500"
        fill="#1B2A3A">Network &amp;</text
      >
      <text
        x="144"
        y="378"
        font-family="Fraunces, Georgia, serif"
        font-size="20"
        font-weight="500"
        fill="#1B2A3A">Interaction Architecture</text
      >
      <text
        x="100"
        y="410"
        font-family="Inter, sans-serif"
        font-size="14"
        fill="#34465A"
      >
        <tspan x="100" dy="0">Structure, modularity, information</tspan>
        <tspan x="100" dy="20">flow, and interaction architecture</tspan>
        <tspan x="100" dy="20">in networked systems.</tspan>
      </text>
      <!-- small network motif -->
      <g transform="translate(180,510)" stroke="#1B2A3A" stroke-opacity="0.55" fill="none" stroke-width="1.25">
        <line x1="0" y1="0" x2="50" y2="-22" />
        <line x1="0" y1="0" x2="60" y2="22" />
        <line x1="0" y1="0" x2="-40" y2="22" />
        <line x1="50" y1="-22" x2="60" y2="22" />
        <line x1="50" y1="-22" x2="100" y2="-2" />
        <line x1="60" y1="22" x2="100" y2="-2" />
        <line x1="-40" y1="22" x2="0" y2="36" />
        <line x1="0" y1="36" x2="60" y2="22" />
      </g>
      <g transform="translate(180,510)">
        <circle cx="0" cy="0" r="6" fill="#FFFBF1" stroke="#1B2A3A" />
        <circle cx="50" cy="-22" r="6" fill="#3A8C8C" />
        <circle cx="60" cy="22" r="6" fill="#D4A02A" />
        <circle cx="-40" cy="22" r="6" fill="#FFFBF1" stroke="#3A8C8C" />
        <circle cx="100" cy="-2" r="6" fill="#FFFBF1" stroke="#E07B3F" />
        <circle cx="0" cy="36" r="6" fill="#1B2A3A" />
      </g>
    </g>

    <!-- Right card: System Behavior & Dynamics -->
    <g>
      <rect
        x="820"
        y="320"
        width="380"
        height="245"
        rx="14"
        fill="#CFE3E1"
        fill-opacity="0.55"
        stroke="#3A8C8C"
        stroke-opacity="0.35"
      />
      <circle cx="858" cy="354" r="14" fill="#3A8C8C" />
      <text
        x="858"
        y="360"
        text-anchor="middle"
        font-family="Inter, sans-serif"
        font-size="16"
        font-weight="700"
        fill="#FFFBF1">3</text
      >
      <text
        x="884"
        y="354"
        font-family="Fraunces, Georgia, serif"
        font-size="20"
        font-weight="500"
        fill="#1B2A3A">System Behavior</text
      >
      <text
        x="884"
        y="378"
        font-family="Fraunces, Georgia, serif"
        font-size="20"
        font-weight="500"
        fill="#1B2A3A">&amp; Dynamics</text
      >
      <text
        x="840"
        y="410"
        font-family="Inter, sans-serif"
        font-size="14"
        fill="#34465A"
      >
        <tspan x="840" dy="0">Emergent structures and behavior,</tspan>
        <tspan x="840" dy="20">social norms, resilience, stability,</tspan>
        <tspan x="840" dy="20">coordination, and cooperation.</tspan>
      </text>
      <!-- drifting waves motif -->
      <g transform="translate(880,510)" fill="none" stroke-width="1.25">
        <path d="M0 0 q30 -20 60 0 t60 0 t60 0" stroke="#3A8C8C" stroke-opacity="0.7" stroke-dasharray="2 3" />
        <path d="M0 14 q30 -20 60 0 t60 0 t60 0" stroke="#D4A02A" stroke-opacity="0.7" stroke-dasharray="2 3" />
      </g>
      <g transform="translate(880,510)">
        <circle cx="0" cy="0" r="4" fill="#D4A02A" />
        <circle cx="40" cy="-8" r="4" fill="#3A8C8C" />
        <circle cx="80" cy="6" r="4" fill="#1B2A3A" />
        <circle cx="120" cy="-2" r="4" fill="#D4A02A" />
        <circle cx="160" cy="-10" r="4" fill="#3A8C8C" />
        <circle cx="200" cy="4" r="4" fill="#1B2A3A" />
      </g>
    </g>

    <!-- Central MAGICS node -->
    <circle cx="640" cy="440" r="155" fill="url(#centerHalo)" />
    <circle
      cx="640"
      cy="440"
      r="138"
      fill="#FFFBF1"
      stroke="#1B2A3A"
      stroke-opacity="0.18"
      stroke-width="1"
    />
    <!-- decorative ring nodes around the central circle -->
    <g>
      <circle cx="640" cy="302" r="6" fill="#D4A02A" />
      <circle cx="778" cy="440" r="6" fill="#3A8C8C" />
      <circle cx="640" cy="578" r="6" fill="#1B2A3A" />
      <circle cx="502" cy="440" r="6" fill="#E07B3F" />
    </g>

    <!-- Mini network inside the center -->
    <g transform="translate(640,400)" stroke="#1B2A3A" stroke-opacity="0.4" stroke-width="1" fill="none">
      <line x1="-44" y1="-22" x2="0" y2="0" />
      <line x1="44" y1="-26" x2="0" y2="0" />
      <line x1="0" y1="0" x2="38" y2="22" />
      <line x1="0" y1="0" x2="-38" y2="22" />
      <line x1="-44" y1="-22" x2="44" y2="-26" />
      <line x1="-38" y1="22" x2="38" y2="22" />
      <line x1="-44" y1="-22" x2="-38" y2="22" />
    </g>
    <g transform="translate(640,400)">
      <circle cx="-44" cy="-22" r="5" fill="#E07B3F" />
      <circle cx="44" cy="-26" r="5" fill="#3A8C8C" />
      <circle cx="0" cy="0" r="6" fill="#1B2A3A" />
      <circle cx="38" cy="22" r="5" fill="#D4A02A" />
      <circle cx="-38" cy="22" r="5" fill="#FFFBF1" stroke="#1B2A3A" />
    </g>

    <text
      x="640"
      y="476"
      text-anchor="middle"
      font-family="Fraunces, Georgia, serif"
      font-size="34"
      font-weight="500"
    >
      <tspan fill="#E07B3F">M</tspan><tspan fill="#D4A02A">A</tspan><tspan
        fill="#1B2A3A">G</tspan
      ><tspan fill="#3A8C8C">I</tspan><tspan fill="#2C6E6E">C</tspan><tspan
        fill="#1B2A3A">S</tspan
      >
    </text>
    <text
      x="640"
      y="498"
      text-anchor="middle"
      font-family="Fraunces, Georgia, serif"
      font-size="16"
      fill="#34465A"
    >
      Lab
    </text>
    <line
      x1="600"
      y1="510"
      x2="680"
      y2="510"
      stroke="#1B2A3A"
      stroke-opacity="0.35"
    />
    <text
      x="640"
      y="530"
      text-anchor="middle"
      font-family="Inter, sans-serif"
      font-size="11"
      fill="#5B6C7E"
    >
      <tspan x="640" dy="0">Design &amp; Governance of</tspan>
      <tspan x="640" dy="14">Intelligent Complex Systems</tspan>
    </text>

    {
      !compact && (
        <g>
          {/* Bottom four-stage strip */}
          <rect
            x="120"
            y="630"
            width="1040"
            height="92"
            rx="12"
            fill="#FFFBF1"
            stroke="#E5D9BE"
          />
          {[
            {
              x: 200,
              label: "UNDERSTAND",
              color: "#E07B3F",
              desc: "Discover & analyze complex systems",
              icon: "search",
            },
            {
              x: 460,
              label: "MODEL",
              color: "#D4A02A",
              desc: "Build analytical, simulation, and empirical models",
              icon: "chart",
            },
            {
              x: 720,
              label: "DESIGN",
              color: "#3A8C8C",
              desc: "Engineer architectures & interventions",
              icon: "pencil",
            },
            {
              x: 980,
              label: "GOVERN",
              color: "#1B2A3A",
              desc: "Align incentives & rules for better outcomes",
              icon: "shield",
            },
          ].map((stage, i, arr) => (
            <g>
              <circle cx={stage.x} cy={676} r={22} fill={stage.color} fill-opacity={0.15} stroke={stage.color} stroke-opacity={0.35} />
              {/* simple icon glyph in the chip */}
              {stage.icon === "search" && (
                <g transform={`translate(${stage.x - 7},${669})`} stroke={stage.color} stroke-width="2" fill="none">
                  <circle cx="5" cy="5" r="5" />
                  <line x1="9" y1="9" x2="14" y2="14" />
                </g>
              )}
              {stage.icon === "chart" && (
                <g transform={`translate(${stage.x - 9},${669})`} stroke={stage.color} stroke-width="2" fill="none">
                  <line x1="0" y1="14" x2="18" y2="14" />
                  <rect x="2" y="8" width="3" height="6" />
                  <rect x="8" y="4" width="3" height="10" />
                  <rect x="14" y="10" width="3" height="4" />
                </g>
              )}
              {stage.icon === "pencil" && (
                <g transform={`translate(${stage.x - 8},${669})`} stroke={stage.color} stroke-width="2" fill="none">
                  <path d="M0 14 L10 4 L14 8 L4 18 Z" transform="translate(0,-3)" />
                </g>
              )}
              {stage.icon === "shield" && (
                <g transform={`translate(${stage.x - 8},${669})`} stroke={stage.color} stroke-width="2" fill="none">
                  <path d="M8 0 L16 4 V10 Q16 14 8 18 Q0 14 0 10 V4 Z" />
                  <path d="M5 10 L7 12 L11 7" />
                </g>
              )}
              <text
                x={stage.x + 38}
                y={672}
                font-family="Inter, sans-serif"
                font-size="13"
                font-weight="700"
                letter-spacing="2"
                fill={stage.color}
              >
                {stage.label}
              </text>
              <text
                x={stage.x + 38}
                y={692}
                font-family="Inter, sans-serif"
                font-size="11"
                fill="#5B6C7E"
              >
                {stage.desc}
              </text>
              {i < arr.length - 1 && (
                <line
                  x1={stage.x + 168}
                  y1={676}
                  x2={arr[i + 1].x - 26}
                  y2={676}
                  stroke="#5B6C7E"
                  stroke-opacity="0.5"
                  stroke-dasharray="3 4"
                  marker-end="url(#arrow)"
                />
              )}
            </g>
          ))}

          <text
            x="640"
            y="752"
            text-anchor="middle"
            font-family="Inter, sans-serif"
            font-size="11"
            letter-spacing="3"
            fill="#34465A"
          >
            INTELLIGENT COMPLEX SYSTEMS FOR A BETTER FUTURE
          </text>
        </g>
      )
    }
  </svg>
</figure>
