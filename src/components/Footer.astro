    <div class="space-y-1 sm:text-right">
      <p>
        Director:{" "}
        <a
          href="https://coe.northeastern.edu/people/heydari-babak/"
          class="underline decoration-ember/40 underline-offset-2 hover:decoration-ember text-ink-soft hover:text-ink"
        >
          Prof. Babak Heydari
        </a>
      </p>
      <p>
        <a
          href="mailto:b.heydari@northeastern.edu"
          class="underline decoration-ember/40 underline-offset-2 hover:decoration-ember text-ink-soft hover:text-ink"
