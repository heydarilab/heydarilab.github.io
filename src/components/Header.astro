---
/**
 * Header — site-wide navigation.
 * Sticks to the top, uses a hairline rule under the bar, and underlines
 * the current section.
 */
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks: Array<{ href: string; label: string }> = [
  { href: "/research", label: "Research" },
  { href: "/highlights", label: "Highlights" },
  { href: "/publications", label: "Publications" },
  { href: "/team", label: "Team" },
  { href: "/news", label: "News" },
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
}
---

<header
  class="sticky top-0 z-30 bg-cream/85 backdrop-blur supports-[backdrop-filter]:bg-cream/70 border-b hairline"
>
  <div
    class="max-w-page mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-6"
  >
    <a
      href="/"
      class="group inline-flex items-baseline gap-2 select-none"
      aria-label="MAGICS Lab — home"
    >
      <span
        class="font-display text-xl sm:text-2xl font-medium tracking-tight"
      >
        <span class="text-ember">M</span><span class="text-gold">A</span
        ><span class="text-ink">G</span><span class="text-teal">I</span
        ><span class="text-teal-dark">C</span><span class="text-ink">S</span>
      </span>
      <span class="hidden sm:inline text-ink-muted text-sm">Lab</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 sm:gap-2 text-sm">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "inline-block px-2.5 py-1.5 rounded transition-colors text-ink-soft hover:text-ink",
                  isActive(link.href) &&
                    "text-ink font-medium underline decoration-ember decoration-2 underline-offset-[6px]",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
