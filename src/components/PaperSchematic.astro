---
/**
 * PaperSchematic — a small registry of inline SVG illustrations used as
 * card art for highlighted papers that don't have a source figure.
 *
 * Each schematic is rendered in a uniform 16:9 box (1280×720 viewBox)
 * with consistent padding so cards on the Highlights page look uniform.
 *
 * To add a new schematic:
 *   1. Add a new id to the SchematicId union below.
 *   2. Add a new <g> case in the switch.
 *   3. Reference it from a markdown file's `schematicId:` field.
 */
import type { SchematicId } from "../lib/schematics";

interface Props {
  id: SchematicId;
  class?: string;
  /** Decorative when true (default); set false when it carries meaning. */
  decorative?: boolean;
  title?: string;
}
const {
  id,
  class: klass = "",
  decorative = true,
  title,
} = Astro.props;

const PALETTE = {
  ember: "#E07B3F",
  emberDark: "#C56630",
  gold: "#D4A02A",
  teal: "#3A8C8C",
  tealDark: "#2C6E6E",
  ink: "#1B2A3A",
  cream: "#FFFBF1",
  rule: "#E5D9BE",
};
---

<svg
  viewBox="0 0 1280 720"
  xmlns="http://www.w3.org/2000/svg"
  class={`w-full h-full ${klass}`}
  role={decorative ? "presentation" : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : title}
>
  <rect width="1280" height="720" fill={PALETTE.cream} />
  <rect x="1" y="1" width="1278" height="718" fill="none" stroke={PALETTE.rule} />

  {
    id === "core-periphery" && (
      <g>
        <text
          x="60"
          y="64"
          font-family="Inter, sans-serif"
          font-size="13"
          letter-spacing="3"
          fill={PALETTE.emberDark}
          font-weight="700"
        >
          CORE — PERIPHERY
        </text>
        {/* core cluster */}
        <g transform="translate(640,360)">
          <circle r="180" fill="none" stroke={PALETTE.rule} stroke-dasharray="4 6" />
          <circle r="80" fill={PALETTE.ember} fill-opacity="0.08" stroke={PALETTE.ember} stroke-opacity="0.35" />

          {/* core: solid nodes (low-imitators) */}
          {([
            [-40, -10],
            [10, -36],
            [42, 20],
            [-12, 36],
            [0, 0],
          ] as const).map(([cx, cy]) => (
            <circle cx={cx} cy={cy} r="11" fill={PALETTE.ink} />
          ))}

          {/* periphery: ringed nodes (high-imitators) */}
          {[
            [-150, -90],
            [-180, 20],
            [-110, 130],
            [10, 170],
            [140, 110],
            [180, -20],
            [120, -120],
            [-10, -170],
          ].map(([cx, cy]) => (
            <g>
              <circle cx={cx} cy={cy} r="11" fill={PALETTE.cream} stroke={PALETTE.teal} stroke-width="2.5" />
              <circle cx={cx} cy={cy} r="4" fill={PALETTE.teal} />
            </g>
          ))}

          {/* edges: a subset, with arrowheads hinting at search/imitation */}
          <g stroke={PALETTE.ink} stroke-opacity="0.35" fill="none" stroke-width="1.25">
            <line x1="-150" y1="-90" x2="-40" y2="-10" />
            <line x1="-180" y1="20" x2="-40" y2="-10" />
            <line x1="-110" y1="130" x2="-12" y2="36" />
            <line x1="10" y1="170" x2="-12" y2="36" />
            <line x1="140" y1="110" x2="42" y2="20" />
            <line x1="180" y1="-20" x2="42" y2="20" />
            <line x1="120" y1="-120" x2="10" y2="-36" />
            <line x1="-10" y1="-170" x2="10" y2="-36" />
            <line x1="-40" y1="-10" x2="0" y2="0" />
            <line x1="10" y1="-36" x2="0" y2="0" />
            <line x1="42" y1="20" x2="0" y2="0" />
            <line x1="-12" y1="36" x2="0" y2="0" />
          </g>
        </g>

        {/* legend */}
        <g
          font-family="Inter, sans-serif"
          font-size="14"
          fill={PALETTE.ink}
        >
          <g transform="translate(70,620)">
            <circle r="9" fill={PALETTE.ink} />
            <text x="20" y="5">low-imitator at core</text>
          </g>
          <g transform="translate(360,620)">
            <circle r="9" fill={PALETTE.cream} stroke={PALETTE.teal} stroke-width="2.5" />
            <circle r="3.5" fill={PALETTE.teal} />
            <text x="20" y="5">high-imitator at periphery</text>
          </g>
        </g>
      </g>
    )
  }

  {
    id === "covid-pipeline" && (
      <g>
        <text
          x="60"
          y="64"
          font-family="Inter, sans-serif"
          font-size="13"
          letter-spacing="3"
          fill={PALETTE.emberDark}
          font-weight="700"
        >
          MICRO-STRUCTURE → POLICY → EPIDEMIC
        </text>

        {/* step a: household + contacts icons */}
        <g transform="translate(120,300)" stroke={PALETTE.ink} stroke-width="2" fill="none">
          {/* house */}
          <path d="M0 40 L0 10 L25 -10 L50 10 L50 40 Z" />
          <rect x="18" y="18" width="14" height="22" fill={PALETTE.gold} fill-opacity="0.35" stroke={PALETTE.ink} />
        </g>
        <g transform="translate(220,300)" stroke={PALETTE.ink} stroke-width="1.5" fill="none">
          {/* contact fan */}
          <circle cx="0" cy="20" r="9" fill={PALETTE.ember} fill-opacity="0.7" stroke={PALETTE.ember} />
          {[-60, -30, 0, 30, 60].map((deg) => (
            <line
              x1="0"
              y1="20"
              x2={Math.sin((deg * Math.PI) / 180) * 70}
              y2={20 - Math.cos((deg * Math.PI) / 180) * 70}
            />
          ))}
          {[-60, -30, 0, 30, 60].map((deg) => (
            <circle
              cx={Math.sin((deg * Math.PI) / 180) * 70}
              cy={20 - Math.cos((deg * Math.PI) / 180) * 70}
              r="5"
              fill={PALETTE.cream}
              stroke={PALETTE.ember}
            />
          ))}
        </g>

        {/* arrow */}
        <g stroke={PALETTE.ink} stroke-opacity="0.6" stroke-width="1.5" fill="none">
          <line x1="340" y1="360" x2="430" y2="360" marker-end="url(#ps-arrow)" />
        </g>

        {/* step b: small-world network */}
        <g transform="translate(540,360)">
          <circle r="100" fill="none" stroke={PALETTE.rule} />
          {Array.from({ length: 14 }).map((_, i) => {
            const a = (i / 14) * Math.PI * 2;
            return (
              <circle
                cx={Math.cos(a) * 100}
                cy={Math.sin(a) * 100}
                r="6"
                fill={i % 4 === 0 ? PALETTE.ember : i % 4 === 1 ? PALETTE.teal : i % 4 === 2 ? PALETTE.gold : PALETTE.ink}
              />
            );
          })}
          <g stroke={PALETTE.ink} stroke-opacity="0.35" stroke-width="1" fill="none">
            {Array.from({ length: 14 }).map((_, i) => {
              const a1 = (i / 14) * Math.PI * 2;
              const a2 = ((i + 1) / 14) * Math.PI * 2;
              return (
                <line
                  x1={Math.cos(a1) * 100}
                  y1={Math.sin(a1) * 100}
                  x2={Math.cos(a2) * 100}
                  y2={Math.sin(a2) * 100}
                />
              );
            })}
            {/* a couple of long-range "weak" ties */}
            <line x1="-100" y1="0" x2="80" y2="58" stroke-dasharray="3 4" />
            <line x1="62" y1="-78" x2="-62" y2="78" stroke-dasharray="3 4" />
          </g>
        </g>

        <g stroke={PALETTE.ink} stroke-opacity="0.6" stroke-width="1.5" fill="none">
          <line x1="660" y1="360" x2="750" y2="360" marker-end="url(#ps-arrow)" />
        </g>

        {/* step c: weak ties removed (policy) */}
        <g transform="translate(860,360)">
          <circle r="100" fill="none" stroke={PALETTE.rule} />
          {Array.from({ length: 14 }).map((_, i) => {
            const a = (i / 14) * Math.PI * 2;
            return (
              <circle
                cx={Math.cos(a) * 100}
                cy={Math.sin(a) * 100}
                r="6"
                fill={i % 4 === 0 ? PALETTE.ember : i % 4 === 1 ? PALETTE.teal : i % 4 === 2 ? PALETTE.gold : PALETTE.ink}
              />
            );
          })}
          <g stroke={PALETTE.ink} stroke-opacity="0.35" stroke-width="1" fill="none">
            {Array.from({ length: 14 }).map((_, i) => {
              const a1 = (i / 14) * Math.PI * 2;
              const a2 = ((i + 1) / 14) * Math.PI * 2;
              return (
                <line
                  x1={Math.cos(a1) * 100}
                  y1={Math.sin(a1) * 100}
                  x2={Math.cos(a2) * 100}
                  y2={Math.sin(a2) * 100}
                />
              );
            })}
          </g>
        </g>

        <g stroke={PALETTE.ink} stroke-opacity="0.6" stroke-width="1.5" fill="none">
          <line x1="970" y1="360" x2="1060" y2="360" marker-end="url(#ps-arrow)" />
        </g>

        {/* step d: SEIR-style curve */}
        <g transform="translate(1090,300)">
          <line x1="0" y1="120" x2="160" y2="120" stroke={PALETTE.ink} stroke-opacity="0.4" />
          <line x1="0" y1="0" x2="0" y2="120" stroke={PALETTE.ink} stroke-opacity="0.4" />
          <path
            d="M0 110 C40 90, 50 30, 80 30 S140 110, 160 115"
            stroke={PALETTE.ember}
            stroke-width="2.5"
            fill="none"
          />
          <path
            d="M0 115 C40 100, 50 60, 80 60 S140 115, 160 118"
            stroke={PALETTE.teal}
            stroke-width="2.5"
            fill="none"
            stroke-dasharray="4 4"
          />
        </g>

        <g
          font-family="Inter, sans-serif"
          font-size="12"
          fill={PALETTE.ink}
          font-weight="600"
        >
          <text x="120" y="500" text-anchor="middle">household</text>
          <text x="230" y="500" text-anchor="middle">contacts</text>
          <text x="540" y="500" text-anchor="middle">contact network</text>
          <text x="860" y="500" text-anchor="middle">policy intervention</text>
          <text x="1170" y="500" text-anchor="middle">cases over time</text>
        </g>

        <defs>
          <marker
            id="ps-arrow"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse"
          >
            <path d="M0,0 L10,5 L0,10 z" fill={PALETTE.ink} fill-opacity="0.6" />
          </marker>
        </defs>
      </g>
    )
  }

  {
    id === "decentralized-recovery" && (
      <g>
        <text
          x="60"
          y="64"
          font-family="Inter, sans-serif"
          font-size="13"
          letter-spacing="3"
          fill={PALETTE.emberDark}
          font-weight="700"
        >
          DISRUPTION → BOTTOM-UP RECONFIGURATION
        </text>

        {/* left: disrupted */}
        <g transform="translate(260,400)">
          <circle r="170" fill="none" stroke={PALETTE.rule} stroke-dasharray="4 6" />
          {[
            [-100, -60, PALETTE.ember],
            [-30, -110, PALETTE.teal],
            [60, -80, PALETTE.gold],
            [110, 10, PALETTE.ink],
            [60, 90, PALETTE.ember],
            [-40, 120, PALETTE.teal],
            [-110, 60, PALETTE.gold],
            [-20, 0, PALETTE.ink],
            [40, -20, PALETTE.ember],
          ].map(([x, y, c]: any) => (
            <circle cx={x} cy={y} r="9" fill={c} />
          ))}
          {/* a couple broken edges (dashed) */}
          <g stroke={PALETTE.ink} stroke-opacity="0.25" stroke-dasharray="2 4" fill="none">
            <line x1="-100" y1="-60" x2="-30" y2="-110" />
            <line x1="60" y1="-80" x2="110" y2="10" />
            <line x1="-20" y1="0" x2="40" y2="-20" />
          </g>
        </g>
        <text
          x="260"
          y="640"
          text-anchor="middle"
          font-family="Inter, sans-serif"
          font-size="12"
          fill={PALETTE.ink}
          font-weight="600"
        >
          disrupted
        </text>

        {/* arrows showing self-organizing reconnection */}
        <g
          stroke={PALETTE.emberDark}
          stroke-opacity="0.7"
          stroke-width="2"
          fill="none"
        >
          <path d="M470 380 Q580 320 690 360" marker-end="url(#dr-arrow)" />
          <path d="M470 460 Q580 520 690 460" marker-end="url(#dr-arrow)" />
          <path d="M470 420 Q580 420 690 410" marker-end="url(#dr-arrow)" />
        </g>

        {/* right: re-formed (differently shaped) */}
        <g transform="translate(900,400)">
          <circle r="170" fill="none" stroke={PALETTE.rule} stroke-dasharray="4 6" />
          {[
            [-60, -100, PALETTE.ember],
            [50, -110, PALETTE.teal],
            [120, -20, PALETTE.gold],
            [80, 80, PALETTE.ink],
            [-20, 120, PALETTE.ember],
            [-110, 50, PALETTE.teal],
            [-90, -50, PALETTE.gold],
            [0, 0, PALETTE.ink],
            [30, -40, PALETTE.ember],
          ].map(([x, y, c]: any) => (
            <circle cx={x} cy={y} r="9" fill={c} />
          ))}
          <g stroke={PALETTE.ink} stroke-opacity="0.45" fill="none" stroke-width="1.25">
            <line x1="-60" y1="-100" x2="50" y2="-110" />
            <line x1="50" y1="-110" x2="120" y2="-20" />
            <line x1="120" y1="-20" x2="80" y2="80" />
            <line x1="80" y1="80" x2="-20" y2="120" />
            <line x1="-20" y1="120" x2="-110" y2="50" />
            <line x1="-110" y1="50" x2="-90" y2="-50" />
            <line x1="-90" y1="-50" x2="-60" y2="-100" />
            <line x1="0" y1="0" x2="30" y2="-40" />
            <line x1="0" y1="0" x2="-90" y2="-50" />
            <line x1="0" y1="0" x2="80" y2="80" />
          </g>
        </g>
        <text
          x="900"
          y="640"
          text-anchor="middle"
          font-family="Inter, sans-serif"
          font-size="12"
          fill={PALETTE.ink}
          font-weight="600"
        >
          re-formed
        </text>

        <defs>
          <marker
            id="dr-arrow"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M0,0 L10,5 L0,10 z" fill={PALETTE.emberDark} />
          </marker>
        </defs>
      </g>
    )
  }

  {
    id === "vae-rl" && (
      <g>
        <text
          x="60"
          y="64"
          font-family="Inter, sans-serif"
          font-size="13"
          letter-spacing="3"
          fill={PALETTE.emberDark}
          font-weight="700"
        >
          GRAPH → LATENT SPACE → POLICY
        </text>

        {/* input graph */}
        <g transform="translate(240,380)">
          <rect x="-130" y="-130" width="260" height="260" rx="14" fill={PALETTE.cream} stroke={PALETTE.rule} />
          {[
            [-70, -70, PALETTE.ember],
            [70, -50, PALETTE.teal],
            [-40, 30, PALETTE.gold],
            [50, 60, PALETTE.ink],
            [0, -30, PALETTE.ember],
            [-90, 30, PALETTE.teal],
            [80, 20, PALETTE.gold],
          ].map(([x, y, c]: any) => (
            <circle cx={x} cy={y} r="9" fill={c} />
          ))}
          <g stroke={PALETTE.ink} stroke-opacity="0.4" fill="none">
            <line x1="-70" y1="-70" x2="0" y2="-30" />
            <line x1="0" y1="-30" x2="70" y2="-50" />
            <line x1="0" y1="-30" x2="-40" y2="30" />
            <line x1="-40" y1="30" x2="50" y2="60" />
            <line x1="-40" y1="30" x2="-90" y2="30" />
            <line x1="50" y1="60" x2="80" y2="20" />
            <line x1="80" y1="20" x2="70" y2="-50" />
          </g>
          <text x="0" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill={PALETTE.ink} font-weight="600">
            networked system
          </text>
        </g>

        {/* VAE funnel */}
        <g transform="translate(530,380)">
          <path d="M0 -130 L130 -50 L130 50 L0 130 Z" fill={PALETTE.gold} fill-opacity="0.18" stroke={PALETTE.gold} stroke-opacity="0.55" />
          <text x="65" y="0" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" fill={PALETTE.ink} font-weight="600">
            VAE
          </text>
          <text x="65" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill={PALETTE.ink} font-weight="600">
            encoder
          </text>
        </g>

        {/* latent space: small Gaussian-y cluster */}
        <g transform="translate(810,380)">
          <ellipse rx="120" ry="100" fill={PALETTE.teal} fill-opacity="0.1" stroke={PALETTE.teal} stroke-opacity="0.5" />
          <ellipse rx="70" ry="50" fill={PALETTE.teal} fill-opacity="0.18" stroke={PALETTE.teal} stroke-opacity="0.4" />
          {[
            [-30, -10],
            [10, -30],
            [40, 20],
            [-20, 35],
            [-60, -40],
            [55, -45],
            [70, 60],
            [0, 0],
          ].map(([x, y]) => (
            <circle cx={x} cy={y} r="3.5" fill={PALETTE.tealDark} />
          ))}
          <text x="0" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill={PALETTE.ink} font-weight="600">
            latent space
          </text>
        </g>

        {/* RL agent */}
        <g transform="translate(1100,380)">
          <rect x="-90" y="-100" width="180" height="200" rx="12" fill={PALETTE.ember} fill-opacity="0.12" stroke={PALETTE.ember} stroke-opacity="0.5" />
          <text x="0" y="-30" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="700" fill={PALETTE.emberDark}>
            RL policy
          </text>
          <text x="0" y="-6" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill={PALETTE.ink}>
            act in latent
          </text>
          <text x="0" y="10" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill={PALETTE.ink}>
            space
          </text>
          <g stroke={PALETTE.emberDark} stroke-width="2" fill="none">
            <path d="M-50 50 L0 30 L50 60" />
            <circle cx="-50" cy="50" r="3" fill={PALETTE.emberDark} />
            <circle cx="0" cy="30" r="3" fill={PALETTE.emberDark} />
            <circle cx="50" cy="60" r="3" fill={PALETTE.emberDark} />
          </g>
          <text x="0" y="160" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill={PALETTE.ink} font-weight="600">
            governance action
          </text>
        </g>

        {/* connecting arrows */}
        <g stroke={PALETTE.ink} stroke-opacity="0.55" stroke-width="1.5" fill="none">
          <line x1="370" y1="380" x2="525" y2="380" marker-end="url(#vae-arrow)" />
          <line x1="665" y1="380" x2="700" y2="380" marker-end="url(#vae-arrow)" />
          <path d="M935 380 L1000 380" marker-end="url(#vae-arrow)" />
        </g>

        <defs>
          <marker
            id="vae-arrow"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="6"
            markerHeight="6"
            orient="auto-start-reverse"
          >
            <path d="M0,0 L10,5 L0,10 z" fill={PALETTE.ink} fill-opacity="0.55" />
          </marker>
        </defs>
      </g>
    )
  }

  {
    id === "hgrl" && (
      <g>
        <text
          x="60"
          y="64"
          font-family="Inter, sans-serif"
          font-size="13"
          letter-spacing="3"
          fill={PALETTE.emberDark}
          font-weight="700"
        >
          HIERARCHICAL CONTROL OF AN EVOLVING NETWORK
        </text>

        {/* upper level: manager */}
        <g transform="translate(640,180)">
          <rect x="-110" y="-40" width="220" height="80" rx="10" fill={PALETTE.ink} fill-opacity="0.08" stroke={PALETTE.ink} stroke-opacity="0.45" />
          <text x="0" y="-6" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="700" fill={PALETTE.ink}>
            high-level manager
          </text>
          <text x="0" y="16" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill={PALETTE.ink}>
            chooses where to intervene
          </text>
        </g>

        {/* mid arrows */}
        <g stroke={PALETTE.ink} stroke-opacity="0.55" stroke-width="1.5" fill="none">
          <line x1="540" y1="220" x2="320" y2="360" marker-end="url(#hg-arrow)" />
          <line x1="640" y1="220" x2="640" y2="360" marker-end="url(#hg-arrow)" />
          <line x1="740" y1="220" x2="960" y2="360" marker-end="url(#hg-arrow)" />
        </g>

        {/* lower level: three local sub-policies */}
        {[
          [320, 440],
          [640, 440],
          [960, 440],
        ].map(([cx, cy]) => (
          <g transform={`translate(${cx},${cy})`}>
            <rect x="-110" y="-50" width="220" height="180" rx="10" fill={PALETTE.cream} stroke={PALETTE.rule} />
            <text x="0" y="-26" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" fill={PALETTE.ink} font-weight="600">
              local sub-policy
            </text>
            {/* mini network inside */}
            {[
              [-60, 10, PALETTE.ember],
              [-20, 50, PALETTE.teal],
              [30, 20, PALETTE.gold],
              [60, 70, PALETTE.ink],
              [-50, 90, PALETTE.ember],
              [20, 100, PALETTE.teal],
            ].map(([x, y, c]: any) => (
              <circle cx={x} cy={y} r="6" fill={c} />
            ))}
            <g stroke={PALETTE.ink} stroke-opacity="0.4" fill="none">
              <line x1="-60" y1="10" x2="-20" y2="50" />
